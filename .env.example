# ============================================================
#  Sequoia-X 配置模板
#
#  用法：复制成 .env 再改（cp .env.example .env）
#  ⚠️ .env 会被 gitignore，可以安全地放密钥
#
#  大多数配置项都可以在 Web 工作台的「设置」页里改，
#  那边有校验、有测试按钮，比手改这个文件更不容易出错。
# ============================================================

# ===== 数据库 =====
# 相对于项目根目录。改成一个新路径等于换一个数据库——
# 新库里没有任何历史数据，需要重新回填（约 1.5 小时）。
DB_PATH=data/sequoia_v2.db

# 回填的起始日期。⚠️ RPS 策略需要 120 个交易日的回看窗口，
# 所以不能设得太近（至少往前留 7~8 个月）。
START_DATE=2024-01-01

# ===== 行情数据源 =====
# baostock   = 项目原设计（免费但会拉黑高频请求的 IP）
# eastmoney  = 东方财富
# tencent    = 腾讯
# sina       = 新浪
# auto       = 按顺序自动探测换源（推荐）
DATA_SOURCE=auto

# auto 模式的尝试顺序。实测速度：新浪 0.56 秒/只、腾讯 1.85 秒/只、
# 东方财富约 0.5 秒/只但连拉几千只会被硬限流，所以新浪排在腾讯前面。
AUTO_SOURCE_ORDER=eastmoney,sina,tencent

# 回填并发线程数。⚠️ 实测 4 线程无间隔连拉 4000+ 只后，
# 东方财富会从「偶发断连」升级为「硬限流」（失败率 13% → 79%）。3 以内较稳。
AK_WORKERS=3

# 每次请求间隔（秒）。0 = 不等待（容易被限流）。
AK_DELAY=0.3

# 某只股票连续多少个交易日拉不到新数据后，允许换源「整只重拉」。
# 设为 1：源不可用就立刻换，保证全市场数据截止日一致（选股不会混用不同截止日）。
REBASE_STALE_DAYS=1

# ===== 选股策略 =====
# 启用哪些策略（逗号分隔的 key）。
# 留空 = 全部启用（默认，保持与升级前一致）。
#
# 可用 key：
#   原项目自带：ma_volume / turtle / flag / shakeout / limit_down / rps / private_placement
#   本项目新增：ma_bullish / macd_cross / boll_breakout / ma_cross /
#              ma_squeeze / vol_price / rsi_rebound / gap_up
#   自定义策略：custom（用自然语言创建的那些）
#
# 这个开关全局生效：命令行、工作台手动触发、每天 19:15 的计划任务读同一份配置。
ENABLED_STRATEGIES=

# 批量选股时是否预加载全市场到内存。
# 开启后 16 个策略从 246 秒降到 67 秒（实测），代价是瞬时约 620MB 内存
# （用完即释放，反复运行不累积）。
# 关掉则每个策略各自查库，选股结果完全一样，只是慢 3.7 倍。
CACHE_MARKET_DATA=true

# ===== 飞书推送（可选）=====
# 主 Webhook。留空则完全不推送（选股结果仍可在工作台里看）。
FEISHU_WEBHOOK_URL=

# 策略专属 Webhook（可选）：只想把某个策略的信号推到另一个群时填。
# 留空走上面的主通道。
# STRATEGY_WEBHOOK_MA_VOLUME=
# STRATEGY_WEBHOOK_TURTLE=
# STRATEGY_WEBHOOK_FLAG=
# STRATEGY_WEBHOOK_SHAKEOUT=
# STRATEGY_WEBHOOK_LIMIT_DOWN=
# STRATEGY_WEBHOOK_RPS=
# STRATEGY_WEBHOOK_PRIVATE_PLACEMENT=

# ===== 大模型分析（可选）=====
# 开启后，每次跑完选股会把「当天市场概况 + 各策略选股」交给大模型分析，
# 分析结果推送到飞书。用的是 OpenAI 兼容的 /chat/completions 接口，
# DeepSeek / 通义 / 智谱 / Moonshot / 本地 Ollama 都能接。
#
# 同一个配置也用于「自然语言创建选股策略」功能。
# ⚠️ 改这些建议走工作台的设置页，那边有「测试大模型」按钮能当场验证。
LLM_ENABLED=0
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ===== Web 工作台 =====
# 只监听 127.0.0.1，局域网其它机器访问不到。
# 改完要重启工作台（关掉窗口重新运行 run-webui.cmd）才生效。
WEBUI_PORT=8899
