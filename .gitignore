data/

# 环境变量（.env 里有飞书 Webhook 和大模型 API Key，绝对不能提交）
.env
.env.bak
.env.tmp

# 打包产物（源码在 build/ 和 installer/ 里，那些要提交）
build/out/
installer/dist/
installer/payload.zip

# 打包构建
*.egg-info/
dist/
build/lib/
build/bdist*/
build/scripts*/

# 测试与工具缓存
.pytest_cache/
.ruff_cache/
.hypothesis/

# 日志
*.log

# 由 verify-payload.ps1 生成（VERIFY-REPORT.md 是手写的，要提交）
installer/verify-report.txt
