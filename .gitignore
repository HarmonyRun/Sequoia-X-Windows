# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# 虚拟环境
venv/
.venv/
env/
ENV/

# IDE 配置
.idea/
.vscode/
.kiro

# 数据库、备份与运行时缓存（整个 data/ 都不入版本库）
